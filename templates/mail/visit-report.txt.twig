{% extends 'mail/layout.txt.twig' %}

{% block content %}
{{ title|default('Visits on ' ~ date) }}

{{ '%-18s %10s %16s'|format('', column_now|default('That day'), column_before|default('7-day average')) }}
{% for measure in measures %}
{{ '%-18s %10d %16.1f'|format(measure.label, measure.day, measure.average) }}
{% endfor %}
{% for list in lists %}

{{ list.heading }}
{% for row in list.rows %}
{{ '%6d  %s'|format(row.events, row.name ?: '(none)') }}
{% endfor %}
{% endfor %}
{% if lists is empty %}

{{ nobody|default('Nobody was counted that day.') }}
{% endif %}
{% endblock %}


{% extends 'mail/layout.html.twig' %}

{% block content %}
<h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;">Choose a new password</h1>
<p style="margin:0 0 16px;font-size:15px;">Hello {{ name }},</p>
<p style="margin:0 0 16px;font-size:15px;">Someone asked to choose a new password for your account ({{ email }}) on the website's control panel. If it was you, open this link within {{ minutes }} minutes:</p>
<p style="margin:0 0 16px;"><a href="{{ link }}" style="display:inline-block;padding:12px 20px;background:#202529;color:#ffffff;border-radius:6px;text-decoration:none;font-weight:700;">Choose a new password</a></p>
<p style="margin:0 0 16px;font-size:15px;">After choosing the password, you'll still be asked for the code from your authenticator app.</p>
<p style="margin:0;color:#5b6168;font-size:14px;">If it wasn't you, there's nothing to do: your password stays as it is, and the link stops working in {{ minutes }} minutes.</p>
{% endblock %}

{% block why %}You get this because "Forgot your password?" was used for your address on this website's control panel.{% endblock %}

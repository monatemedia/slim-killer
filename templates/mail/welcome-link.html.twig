{% extends 'mail/layout.html.twig' %}

{% block content %}
<h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;">{{ reset ? 'Your account was reset' : 'Welcome to the control panel' }}</h1>
<p style="margin:0 0 16px;font-size:15px;">Hello {{ name }},</p>
{% if reset %}
<p style="margin:0 0 16px;font-size:15px;">{{ by }} reset your account on the website's control panel. Your old password and two-factor no longer work.</p>
{% else %}
<p style="margin:0 0 16px;font-size:15px;">{{ by }} added you to the website's control panel, so you can change the words and photos on your website.</p>
{% endif %}
<p style="margin:0 0 16px;font-size:15px;">Open this link within {{ hours }} hours to choose a password and set up two-factor sign-in with your phone:</p>
<p style="margin:0 0 16px;"><a href="{{ link }}" style="display:inline-block;padding:12px 20px;background:#202529;color:#ffffff;border-radius:6px;text-decoration:none;font-weight:700;">Choose your password</a></p>
<p style="margin:0;color:#5b6168;font-size:14px;">The link works once. If it has expired, ask {{ by }} for a new one.</p>
{% endblock %}

{% block why %}You get this because {{ by }} {{ reset ? 'reset' : 'added' }} your account ({{ email }}) on this website's control panel.{% endblock %}

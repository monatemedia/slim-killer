<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{% block title %}Control panel{% endblock %} · Slim Killer</title>
<link rel="icon" type="image/svg+xml" href="{{ base }}/assets/logo.svg">
<script src="{{ asset('theme.js') }}"></script>
<link rel="stylesheet" href="{{ asset('cp.css') }}">
<script src="{{ asset('cp.js') }}" defer></script>
</head>
<body>
<div class="shell{% block shell %}{% endblock %}">

  <header class="page-header">
    <div class="header-row">
      <a class="brand" href="{{ base }}/">
        <span class="logo"><img src="{{ base }}/assets/logo.svg" alt=""></span>
        <span class="brand-name"><span>Slim</span> <span class="accent">Killer</span></span>
      </a>
      {# Shown by cp.js: without JavaScript the panel follows the phone's own setting. #}
      <button type="button" class="theme-switch" data-theme-switch hidden aria-label="Switch between light and dark">
        <svg class="icon-moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M20.7 14.6A8.5 8.5 0 0 1 9.4 3.3a.7.7 0 0 0-.9-.9A10 10 0 1 0 21.6 15.5a.7.7 0 0 0-.9-.9Z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></g></svg>
      </button>
    </div>
    {% block publishing %}{% endblock %}
  </header>

  <main>
    {% block main %}{% endblock %}
  </main>

  <footer class="page-footer">
    <a class="footer-logo" href="https://www.monatemedia.com/" rel="noreferrer"><img src="{{ base }}/assets/monate-media.png" alt="Monate Media"></a>
    <p>MIT licensed · Monate Media</p>
    <p class="footer-joke">No plugins were harmed in the making of this site.</p>
  </footer>

</div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{% block title %}Control panel{% endblock %} · Slim Killer</title>
<link rel="icon" type="image/svg+xml" href="{{ base }}/assets/logo.svg">
<link rel="stylesheet" href="{{ base }}/assets/cp.css">
<script src="{{ base }}/assets/cp.js" defer></script>
</head>
<body>
<div class="shell">

  <header class="page-header">
    <a class="logo" href="{{ base }}/"><img src="{{ base }}/assets/logo.svg" alt="Slim Killer home"></a>
    <p class="brand-name"><span>Slim</span> <span class="accent">Killer</span></p>
  </header>

  <main>
    {% block main %}{% endblock %}
  </main>

  <footer class="page-footer">
    <a class="footer-logo" href="https://www.monatemedia.com/" rel="noreferrer"><img src="{{ base }}/assets/monate-media.png" alt="Monate Media"></a>
    <p>MIT licensed · Monate Media</p>
    <p class="footer-joke">No plugins were harmed in the making of this site.</p>
  </footer>

</div>
</body>
</html>

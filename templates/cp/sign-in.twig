{% extends 'cp/layout.twig' %}
{% import 'cp/_fields.twig' as fields %}

{# Signed out (or never signed in) in this browser: the website bar's marker goes. #}
{% block body_attrs %} data-editor-bar="out"{% endblock %}

{% block title %}Sign in{% endblock %}

{# Signed out, the logo leads back to the website. #}
{% block brand_link %}/{% endblock %}

{% block main %}
<section class="card narrow">
  <div class="card-pad">
    <h1 class="form-title">Sign in</h1>
    {% if error %}<p class="form-error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="{{ base }}/sign-in" class="form" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <div class="field">
        <label for="email">Email address</label>
        <input id="email" type="email" name="email" value="{{ email }}" autocomplete="username"{{ email ? '' : ' autofocus' }}>
      </div>
      {{ fields.password('password', 'Password', 'current-password', email != '') }}
      <button type="submit" class="btn">Continue</button>
    </form>
    <p class="form-help">Next, you will be asked for the six-digit code from your authenticator app.</p>
    <p class="form-help"><a href="{{ base }}/forgot-password">Forgot your password?</a></p>
    <p class="form-help">Lost your phone? Ask whoever set up your account to reset it.</p>
  </div>
</section>
{% endblock %}

{% extends 'cp/layout.twig' %}
{% import 'cp/_fields.twig' as fields %}

{% block title %}Sign in{% endblock %}

{% block main %}
<section class="card narrow">
  <div class="card-pad">
    <h1 class="form-title">Sign in</h1>
    {% if error %}<p class="form-error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="{{ base }}/login" class="form" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <div class="field">
        <label for="email">Email address</label>
        <input id="email" type="email" name="email" value="{{ email }}" autocomplete="username"{{ email ? '' : ' autofocus' }}>
      </div>
      {{ fields.password('password', 'Password', 'current-password', email != '') }}
      <button type="submit" class="btn">Continue</button>
    </form>
    <p class="form-help">Next, you will be asked for the six-digit code from your authenticator app.</p>
    <p class="form-help">Forgotten your password, or lost your phone? Ask whoever set up your account to reset it.</p>
  </div>
</section>
{% endblock %}

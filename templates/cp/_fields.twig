{#
 # A password field with a show/hide button. The button stays hidden unless
 # cp.js runs, so without JavaScript the field still works as a plain one.
 #}
{% macro password(name, label, autocomplete, autofocus = false) %}
<div class="field">
  <label for="{{ name }}">{{ label }}</label>
  <div class="reveal">
    <input id="{{ name }}" type="password" name="{{ name }}" autocomplete="{{ autocomplete }}"{{ autofocus ? ' autofocus' : '' }}>
    <button type="button" class="reveal-toggle" data-reveal="{{ name }}" aria-label="Show password" aria-pressed="false" hidden>
      <svg class="icon-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
      <svg class="icon-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 19c-6.5 0-10-7-10-7a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c6.5 0 10 7 10 7a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
    </button>
  </div>
</div>
{% endmacro %}

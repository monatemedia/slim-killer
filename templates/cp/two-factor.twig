{% extends 'cp/layout.twig' %}

{% block title %}Two-factor code{% endblock %}

{% block main %}
<section class="card narrow">
  <div class="card-pad">
    <h1 class="form-title">Enter your code</h1>
    <p class="form-lede">Your password was right. Now open your authenticator app (Google Authenticator, for most people) and type the six-digit code it shows for {{ site_name }}.</p>
    {% if error %}<p class="form-error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="{{ base }}/two-factor" class="form" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <div class="field">
        <label for="code">Code</label>
        <input id="code" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="11" autofocus class="code-input">
      </div>
      <button type="submit" class="btn">Sign in</button>
    </form>
    <p class="form-help">No phone? Type one of your recovery codes in the box above instead of the six-digit code. They look like <code>ab3cd-ef4gh</code>, and each works once.</p>
  </div>
</section>
{% endblock %}

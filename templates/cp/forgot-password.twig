{% extends 'cp/layout.twig' %}

{% block body_attrs %} data-editor-bar="out"{% endblock %}

{% block title %}Forgot your password?{% endblock %}

{% block brand_link %}/{% endblock %}

{% block main %}
<section class="card narrow">
  <div class="card-pad">
    <h1 class="form-title">Forgot your password?</h1>
    {% if can_send %}
      <p class="form-lede">Type the email address you sign in with. We'll email you a link to choose a new password. You'll still need the code from your authenticator app.</p>
      {% if error %}<p class="form-error" role="alert">{{ error }}</p>{% endif %}
      <form method="post" action="{{ base }}/forgot-password" class="form" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <div class="field">
          <label for="email">Email address</label>
          <input id="email" type="email" name="email" value="{{ email }}" autocomplete="username" autofocus>
        </div>
        <button type="submit" class="btn">Email me a link</button>
      </form>
    {% else %}
      <p class="form-lede">This website can't send email yet, so ask whoever set up your account to reset it.</p>
    {% endif %}
    <p class="form-help">Lost your phone? Ask whoever set up your account to reset it.</p>
    <p class="form-help"><a href="{{ base }}/sign-in">Back to signing in</a></p>
  </div>
</section>
{% endblock %}

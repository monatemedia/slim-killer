{% extends 'cp/layout.twig' %}

{% block shell %} shell-wide{% endblock %}

{% block title %}Control panel{% endblock %}

{% block publishing %}{% include 'cp/_publishing.twig' %}{% endblock %}

{% block main %}
<section class="hero">
  <h1>Hello, {{ name }}.</h1>
  <p>You are signed in as {{ role }}.</p>
</section>

<a class="tile tile-wide" href="{{ base }}/content">
  <span class="tile-title">Your content</span>
  <span class="tile-meta">Change the words on the pages of your website.</span>
</a>

<section class="card">
  <div class="card-pad">
    <h2 class="card-title">Your account</h2>
    <p class="form-help">Two-factor sign-in is on. You have {{ codes_left }} recovery {{ codes_left == 1 ? 'code' : 'codes' }} left.</p>
    <form method="post" action="{{ base }}/sign-out" class="form-inline">
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <button type="submit" class="btn btn-quiet">Sign out</button>
    </form>
  </div>
</section>
{% endblock %}

{% extends 'cp/layout.twig' %}

{% block shell %} shell-wide{% endblock %}

{% block body_attrs %} data-editor-bar="{{ website_bar }}"{% endblock %}

{% block title %}Control panel{% endblock %}

{% block publishing %}{% include 'cp/_publishing.twig' %}{% endblock %}

{% block main %}
<section class="hero">
  <h1>Hello, {{ name }}.</h1>
  <p>You are signed in as {{ role }}.</p>
</section>

{% if update %}
<section class="card card-update">
  <div class="card-pad">
    <h2 class="card-title">Slim Killer v{{ update.latest }} is out</h2>
    <p class="form-help">This website runs v{{ update.installed }}. <a href="{{ changelog_url }}" rel="noopener" target="_blank">What's new</a>, and what to run after updating.</p>
  </div>
</section>
{% endif %}

<a class="tile tile-wide" href="{{ base }}/content">
  <span class="tile-title">Your content</span>
  <span class="tile-meta">Change the words on the pages of your website.</span>
</a>

<a class="tile tile-wide" href="{{ base }}/visits">
  <span class="tile-title">Visits</span>
  <span class="tile-meta">See how many people came to your website, where they came from and what they did.</span>
</a>

<a class="tile tile-wide" href="{{ base }}/people">
  <span class="tile-title">People</span>
  <span class="tile-meta">Who can use this control panel. Add someone, or reset an account.</span>
</a>

<section class="card">
  <div class="card-pad">
    <h2 class="card-title">Your account</h2>
    <p class="form-help">Two-factor sign-in is on. You have {{ codes_left }} recovery {{ codes_left == 1 ? 'code' : 'codes' }} left.</p>
    <p class="form-help"><a href="{{ base }}/preferences">Preferences</a>: your password, and whether you see the website bar on your website.</p>
    <form method="post" action="{{ base }}/sign-out" class="form-inline">
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <button type="submit" class="btn btn-quiet">Sign out</button>
    </form>
  </div>
</section>
{% endblock %}

{% extends 'cp/layout.twig' %}
{% import 'cp/_fields.twig' as fields %}

{% block title %}Choose a new password{% endblock %}

{% block main %}
<section class="card narrow">
  <div class="card-pad">
    <h1 class="form-title">Choose a new password</h1>
    <p class="form-lede">For <strong>{{ email }}</strong>. Use at least {{ min_length }} characters, and not one of your last three passwords.</p>
    {% if error %}<p class="form-error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="{{ base }}/reset-password" class="form" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <input type="hidden" name="username" value="{{ email }}" autocomplete="username">
      {{ fields.password('password', 'New password', 'new-password', true) }}
      {{ fields.password('password_confirmation', 'The same password again', 'new-password') }}
      <button type="submit" class="btn">Save and continue</button>
    </form>
    <p class="form-help">Next, type the code from your authenticator app, as when you sign in.</p>
  </div>
</section>
{% endblock %}

{% extends 'cp/layout.twig' %}
{% import 'cp/_fields.twig' as fields %}

{% block body_attrs %} data-editor-bar="{{ website_bar }}"{% endblock %}

{% block title %}Preferences{% endblock %}

{% block main %}
<nav class="crumbs" aria-label="You are here"><a href="{{ base }}/">Dashboard</a> › Preferences</nav>

<section class="hero">
  <h1>Preferences</h1>
  <p>Your own choices. They don't change anything for anyone else.</p>
</section>

{% if saved == 'bar' %}
  <p class="read-only-note" role="status">Saved. This browser knows already; on your other devices, open the control panel once.</p>
{% elseif saved == 'emails' %}
  <p class="read-only-note" role="status">Saved. {{ report.frequency == 'off' ? 'No visit report.' : 'Next visit report: ' ~ report.next ~ '.' }}</p>
{% elseif saved == 'two-factor' %}
  <p class="read-only-note" role="status">Two-factor is set up again. Codes from the old app no longer work, and you're signed out on your other devices. Delete the old entry from the old app.</p>
{% elseif saved == 'password' %}
  <p class="read-only-note" role="status">Your password is changed. You're signed out on your other devices, and an email is on its way to say so.</p>
{% endif %}

<form method="post" action="{{ base }}/preferences" class="card">
  <div class="card-pad">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <fieldset class="choices">
      <legend class="card-title">The website bar</legend>
      <p class="form-help">While you're signed in, a small button sits in the bottom-right corner of your website. Tap it to edit the page you're on, or to go to the control panel or Visits.</p>
      <label class="choice">
        <input type="radio" name="website_bar" value="show"{{ website_bar == 'show' ? ' checked' }}>
        <span><strong>Show it</strong><br>You can still hide it from the button itself, until you next open the control panel.</span>
      </label>
      <label class="choice">
        <input type="radio" name="website_bar" value="hide"{{ website_bar == 'hide' ? ' checked' }}>
        <span><strong>Don't show it</strong><br>The website looks exactly as visitors see it.</span>
      </label>
      <p class="form-help">Either way, while you're signed in your own visits aren't counted.</p>
    </fieldset>
    <button type="submit" class="btn">Save</button>
  </div>
</form>

<form method="post" action="{{ base }}/preferences" class="card" id="emails" novalidate>
  <div class="card-pad">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <input type="hidden" name="form" value="emails">
    <h2 class="card-title">Emails</h2>
    <p class="form-help">The visit report: how many people came to your website, where they came from and what they did. {{ report.frequency == 'off' ? 'You don\'t get it now.' : report.describe ~ ', next on ' ~ report.next ~ '.' }}</p>
    <div class="form form-spaced">
      <div class="field">
        <label for="frequency">The visit report</label>
        <select id="frequency" name="frequency" data-report-frequency>
          {% for value, label in {'off': 'Never', 'daily': 'Every day', 'weekly': 'Every week', 'monthly': 'Every month'} %}
            <option value="{{ value }}"{{ report.frequency == value ? ' selected' }}>{{ label }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="field" data-report-for="weekly">
        <label for="weekday">On</label>
        <select id="weekday" name="weekday">
          {% for number, day in weekdays %}
            <option value="{{ number }}"{{ report.weekday == number ? ' selected' }}>{{ day }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="field" data-report-for="monthly">
        <label for="date">On the</label>
        <select id="date" name="date">
          {% for number in 1..last_date %}
            <option value="{{ number }}"{{ report.date == number ? ' selected' }}>{{ number }}{{ number in [1, 21] ? 'st' : (number in [2, 22] ? 'nd' : (number in [3, 23] ? 'rd' : 'th')) }}</option>
          {% endfor %}
          <option value="0"{{ report.date == 0 ? ' selected' }}>Last day of the month</option>
        </select>
      </div>
      <div class="field" data-report-for="daily weekly monthly">
        <label for="hour">At</label>
        <select id="hour" name="hour">
          {% for hour in 0..23 %}
            <option value="{{ hour }}"{{ report.hour == hour ? ' selected' }}>{{ '%02d:00'|format(hour) }}</option>
          {% endfor %}
        </select>
      </div>
      <p class="form-help">A daily report covers the day before; a weekly one the 7 days before; a monthly one the month before. Each is compared with the time before it.</p>
      <label class="choice">
        <input type="checkbox" name="alerts" value="1"{{ alerts ? ' checked' }}>
        <span><strong>Email me when something stops working</strong><br>Like backups, publishing or email itself. One email when it stops, and one when it works again.</span>
      </label>
      <div><button type="submit" class="btn">Save</button></div>
    </div>
  </div>
</form>

<form method="post" action="{{ base }}/preferences" class="card" id="your-password" novalidate>
  <div class="card-pad">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <input type="hidden" name="form" value="password">
    <h2 class="card-title">Your password</h2>
    <p class="form-help">Use at least {{ min_length }} characters, and not one of your last three passwords. Changing it signs you out on your other devices.</p>
    {% if password_error %}<p class="form-error" role="alert">{{ password_error }}</p>{% endif %}
    <div class="form form-spaced">
      {{ fields.password('current_password', 'Current password', 'off', false, true) }}
      {{ fields.password('password', 'New password', 'new-password') }}
      {{ fields.password('password_confirmation', 'The same new password again', 'new-password') }}
      <div><button type="submit" class="btn">Change password</button></div>
    </div>
  </div>
</form>

<form method="post" action="{{ base }}/preferences" class="card" id="two-factor" novalidate>
  <div class="card-pad">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <input type="hidden" name="form" value="two-factor">
    <h2 class="card-title">Two-factor</h2>
    <p class="form-help">On, with {{ codes_left }} recovery {{ codes_left == 1 ? 'code' : 'codes' }} left. If someone may have seen your recovery codes, make new ones. For a new phone, or if your setup key or QR code may have been seen, set up two-factor again.</p>
    <p class="form-help">Lost your phone? Ask whoever set up your account to reset it.</p>
    {% if two_factor_error %}<p class="form-error" role="alert">{{ two_factor_error }}</p>{% endif %}
    <div class="form form-spaced">
      {{ fields.password('two_factor_password', 'Your password', 'off', false, true) }}
      <div class="field">
        <label for="code">A code from your authenticator app</label>
        <input id="code" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" class="code-input">
      </div>
      <div class="form-buttons">
        <button type="submit" name="task" value="codes" class="btn btn-quiet">Make new recovery codes</button>
        <button type="submit" name="task" value="app" class="btn btn-quiet">Set up two-factor again</button>
      </div>
    </div>
  </div>
</form>
{% endblock %}

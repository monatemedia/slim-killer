{% extends 'cp/layout.twig' %}
{% import 'cp/_fields.twig' as fields %}

{% block title %}Welcome{% endblock %}

{% block main %}
<section class="card narrow">
  <div class="card-pad">
    <h1 class="form-title">Welcome, {{ name }}</h1>
    <p class="form-lede">Choose a password for <strong>{{ email }}</strong>. Use at least {{ min_length }} characters: a few words in a row works well, and is easy to remember.</p>
    {% if error %}<p class="form-error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="{{ base }}/welcome" class="form" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <input type="hidden" name="username" value="{{ email }}" autocomplete="username">
      {{ fields.password('password', 'New password', 'new-password', true) }}
      {{ fields.password('password_confirmation', 'The same password again', 'new-password') }}
      <button type="submit" class="btn">Save and continue</button>
    </form>
    <p class="form-help">Next, you will set up two-factor sign-in with your phone.</p>
  </div>
</section>
{% endblock %}

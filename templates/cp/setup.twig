{% extends 'cp/layout.twig' %}

{% block title %}Setup{% endblock %}

{% block main %}
<section class="hero">
  <h1>It's alive.</h1>
  <p>Slim Killer is installed on <strong>{{ host }}</strong>. Here is how this server measures up, and what to do next.</p>
</section>

<section class="card" aria-label="Host checks">

  <div class="summary">
    <span class="summary-counts"><strong>{{ passed }}</strong> passed · <strong>{{ warnings }}</strong> warnings · <strong>{{ failed }}</strong> failed</span>
    {% if ready %}
      <span class="state-tag ready">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        Ready
      </span>
    {% else %}
      <span class="state-tag attention">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
        Needs attention
      </span>
    {% endif %}
  </div>

  {% for section in sections %}
    <div class="group">
      <p class="group-label">{{ section.title }}</p>
      {% if loop.first %}
        <p class="checked-note">Checked just now, by this page.</p>
      {% elseif loop.index == 2 %}
        <p class="checked-note">Checked by <code>hammer doctor</code> {{ checked_ago }} ago.</p>
      {% endif %}

      {% for row in section.rows %}
        <div class="row">
          <span class="pill {{ row.status }}">{{ row.label }}</span>
          <div>
            <p class="row-title">{{ row.title }}</p>
            {% if row.detail %}<p class="row-detail">{{ row.detail }}</p>{% endif %}
            {% if row.hint %}<p class="row-hint{{ row.status == 'fail' ? ' fail-hint' : '' }}">{{ row.hint }}</p>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% endfor %}

  {% if checked_ago is null %}
    <div class="group">
      <p class="group-label">Server and command line</p>
      <div class="row">
        <span class="pill warn">WARN</span>
        <div>
          <p class="row-title">Not checked yet</p>
          <p class="row-detail">Cron, the PHP for the command line and outgoing connections can only be checked from the server.</p>
          <p class="row-hint">Run <code>php hammer doctor</code> on the server, then open the new link it prints.</p>
        </div>
      </div>
    </div>
  {% endif %}

  <div class="card-actions">
    <a class="link-btn" href="{{ base }}/setup?token={{ token|url_encode }}">Run the checks again</a>
  </div>

</section>

<section class="next" aria-label="Next steps">
  <h2 class="card-title">Next steps</h2>
  <div class="steps">

    <article class="step">
      <div class="step-num">1</div>
      <h3>Fix anything marked FAIL</h3>
      <p>Each one says how. Then run the doctor again:</p>
      <code class="next-cmd">php hammer doctor</code>
    </article>

    <article class="step">
      <div class="step-num">2</div>
      <h3>Add the cron job, every minute</h3>
      <p>The exact line is in the cron check above, with the full path to the right PHP.</p>
    </article>

    <article class="step">
      <div class="step-num">3</div>
      <h3>Install, and create your account</h3>
      <p>It prints a welcome link. Open it to choose a password and set up two-factor.</p>
      <code class="next-cmd">php hammer install --url=… --email=… --name=…</code>
    </article>

  </div>
</section>


{% extends 'cp/layout.twig' %}
{% import 'cp/content/_fields.twig' as forms %}

{% block shell %} shell-wide{% endblock %}

{% block title %}{{ entry.title }}{% endblock %}

{% block publishing %}{% include 'cp/_publishing.twig' %}{% endblock %}

{% block main %}
<nav class="crumbs" aria-label="You are here"><a href="{{ base }}/">Dashboard</a> › <a href="{{ base }}/content">Content</a> › <a href="{{ base }}/content/{{ collection.name }}">{{ collection.label }}</a> › {{ entry.title }}</nav>

<section class="hero">
  <h1>{{ entry.title }}</h1>
</section>
{% if entry.address %}
<p class="entry-address">Web address: <a href="{{ entry.link }}" target="_blank" rel="noopener"><code>{{ entry.address }}</code></a></p>
{% endif %}

{% if problem %}
  <div class="form-problems" role="alert" tabindex="-1">
    <p><strong>Your changes are not saved yet.</strong></p>
    <p>{{ problem }}</p>
  </div>
{% elseif errors is not empty %}
  <div class="form-problems" role="alert" tabindex="-1">
    <p><strong>{{ errors|length == 1 ? 'One thing needs' : errors|length ~ ' things need' }} changing before this page can be saved.</strong></p>
    <ul>
      {% for path, message in errors %}
        <li><a href="#f-{{ path|replace({'.': '-'}) }}">{{ message }}</a></li>
      {% endfor %}
    </ul>
  </div>
{% elseif notice %}
  <p class="read-only-note" role="status">{{ notice }}</p>
{% endif %}

<form method="post" action="{{ base }}/content/{{ collection.name }}/{{ entry.slug }}" class="card entry-form" enctype="multipart/form-data" novalidate autocomplete="off">
  <input type="hidden" name="_csrf" value="{{ csrf }}">
  <input type="hidden" name="version" value="{{ entry.version }}">
  {# Enter in a text box presses the first submit button: make that one Save, not a list button. #}
  <button type="submit" class="default-submit" tabindex="-1" aria-hidden="true">Save</button>
  <div class="card-pad form">
    {% for field in fields %}
      {{ forms.field(field, values[field.name] ?? null, field.name, errors, focus, photos) }}
    {% endfor %}

    {% if entry.hasBody %}
      <div class="field">
        <div class="field-label"><label for="f-body">Text</label></div>
        {# The line break after the tag is dropped by the browser, so a body that starts with a blank line keeps it. #}
        <textarea id="f-body" name="body" rows="16" class="markdown-input">
{{ entry.body }}</textarea>
      </div>
    {% endif %}
  </div>
  <div class="card-actions">
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-quiet" href="{{ base }}/content/{{ collection.name }}/{{ entry.slug }}">Discard changes</a>
  </div>
</form>

{# One photo chooser for the whole page, opened by each image field's "Choose a photo"
   (JavaScript). The previews only load when it opens. #}
{% if photos is not empty %}
<dialog class="photo-picker" id="photo-picker" aria-labelledby="photo-picker-title">
  <div class="photo-picker-head">
    <h2 id="photo-picker-title">Choose a photo</h2>
    <form method="dialog"><button class="btn btn-quiet btn-small">Close</button></form>
  </div>
  <div class="photo-grid">
    {% for file, preview in photos %}
      <button type="button" class="photo-option" data-file="{{ file }}" data-preview="{{ base }}/photos/{{ preview }}">
        <img src="{{ base }}/photos/{{ preview }}" alt="" loading="lazy">
        <span>{{ file }}</span>
      </button>
    {% endfor %}
  </div>
</dialog>
{% endif %}
{% endblock %}

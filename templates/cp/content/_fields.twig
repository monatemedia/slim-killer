{#
 # Editing fields, built from the collection's schema (Field objects).
 #
 # field(field, value, path, errors):
 #   path    the field's place in the form, dotted: "cta.heading", "sections.2.image.src".
 #           It names the input (f[cta][heading]), its id and its error.
 #   errors  problems from the last save, keyed by path.
 #}
{% macro field(field, value, path, errors) %}
  {% import _self as forms %}
  {% set editor = field.editor() %}
  {% set id = 'f-' ~ path|replace({'.': '-'}) %}
  {% set name = 'f[' ~ path|split('.')|join('][') ~ ']' %}
  {% set error = errors[path] ?? null %}
  {% set text = value is iterable ? value|json_encode : value %}

  {% if editor == 'group' %}
    <fieldset class="group-field">
      <legend>{{ field.label }}{{ forms.tip(field, id) }}</legend>
      {% for child in field.children %}
        {{ forms.field(child, value[child.name] ?? null, path ~ '.' ~ child.name, errors) }}
      {% endfor %}
    </fieldset>

  {% elseif editor == 'list' %}
    <fieldset class="list-field">
      <legend>{{ field.label }} <span class="count">{{ value is iterable ? value|length : 0 }}</span>{{ forms.tip(field, id) }}</legend>
      {% for item in value is iterable ? value : [] %}
        <div class="list-item">
          <p class="list-item-label">{{ loop.index }}</p>
          {% for child in field.children %}
            {{ forms.field(child, item[child.name] ?? null, path ~ '.' ~ loop.parent.loop.index0 ~ '.' ~ child.name, errors) }}
          {% endfor %}
        </div>
      {% else %}
        <p class="field-help">None yet.</p>
      {% endfor %}
    </fieldset>

  {% else %}
    <div class="field{{ error ? ' has-error' : '' }}">
      <div class="field-label">
        <label for="{{ id }}">{{ field.label }}{% if not field.required %} <span class="optional">(optional)</span>{% endif %}</label>
        {{ forms.tip(field, id) }}
      </div>
      {% set described = (error ? id ~ '-error ' : '') ~ (field.maxLength ? id ~ '-count' : '') %}
      {% set aria = described|trim ? ' aria-describedby="' ~ described|trim ~ '"' : '' %}
      {% set limit = field.maxLength ? ' maxlength="' ~ field.maxLength ~ '" data-count="' ~ id ~ '-count"' : '' %}

      {% if editor == 'textarea' or editor == 'markdown' %}
        <textarea id="{{ id }}" name="{{ name }}" rows="{{ editor == 'markdown' ? 10 : 4 }}" class="{{ editor == 'markdown' ? 'markdown-input' : '' }}"{{ limit|raw }}{{ aria|raw }}>{{ text }}</textarea>
      {% elseif editor == 'select' %}
        <select id="{{ id }}" name="{{ name }}"{{ aria|raw }}>
          {% if not field.required %}<option value="">Let the page decide</option>{% endif %}
          {% for option in field.options %}
            <option{{ option == value ? ' selected' : '' }}>{{ option }}</option>
          {% endfor %}
        </select>
      {% elseif editor == 'toggle' %}
        <input type="hidden" name="{{ name }}" value="0">
        <input id="{{ id }}" name="{{ name }}" type="checkbox" value="1"{{ value ? ' checked' : '' }}{{ aria|raw }}>
      {% elseif editor == 'tags' %}
        <input id="{{ id }}" name="{{ name }}" type="text" value="{{ value is iterable ? value|join(', ') : value }}"{{ aria|raw }}>
        <p class="field-help">Separate them with commas.</p>
      {% else %}
        <input id="{{ id }}" name="{{ name }}" type="{{ editor == 'number' ? 'number' : 'text' }}"{{ field.integer ? ' step="1"' : (editor == 'number' ? ' step="any"' : '') }} value="{{ text }}"{{ limit|raw }}{{ aria|raw }}>
      {% endif %}

      {% if error or field.maxLength %}
        <div class="field-foot">
          {% if error %}<p class="field-error" id="{{ id }}-error">{{ error }}</p>{% endif %}
          {% if field.maxLength %}<p class="field-count" id="{{ id }}-count">{{ (text ?? '')|length }} of {{ field.maxLength }} characters</p>{% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}
{% endmacro %}

{#
 # The help text behind a "?": open it to read why the field is there. Plain HTML
 # (<details>), so it works without JavaScript.
 #}
{% macro tip(field, id) %}
  {% if field.help %}
    <details class="field-tip">
      <summary aria-label="What is {{ field.label }}?">?</summary>
      <p id="{{ id }}-help">{{ field.help }}</p>
    </details>
  {% endif %}
{% endmacro %}

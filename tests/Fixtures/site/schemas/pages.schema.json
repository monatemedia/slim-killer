{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": { "type": "string" },
          "imagePosition": { "default": "left", "type": "string", "enum": ["left", "right"] },
          "featured": { "type": "boolean" },
          "order": { "type": "number" },
          "quote": {
            "type": "object",
            "properties": { "text": { "type": "string" }, "cite": { "type": "string" } },
            "required": ["text", "cite"]
          }
        },
        "required": ["heading"]
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["title"]
}

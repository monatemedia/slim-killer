# Copy to .env, or let `php hammer install` write it.
# The website's address, used in the links hammer prints.
APP_URL="https://example.com"
# The site's own name: shown in authenticator apps and on downloaded recovery codes.
APP_NAME="Slim Killer"

# Where the control panel reads content from. Leave both empty on a client's host: the
# panel keeps its working copy in storage/site/. For local development, point them at an
# Astro site's content folder and at the schemas `npx astro sync` writes. Relative paths
# start from this folder.
CONTENT_DIR=""
SCHEMA_DIR=""

# Saving. The client site's repository ("owner/name"), the branch saves go to, a
# fine-grained token with "Contents: read and write" on that one repository, and the
# folder in the repository that holds content/. Never commit a real token.
GITHUB_REPOSITORY=""
GITHUB_BRANCH="main"
GITHUB_TOKEN=""
GITHUB_CONTENT_FOLDER="content"

# Publishing. The folder the website is served from, for example
# ~/domains/example.com/public_html. Builds are fetched from the repository's dist
# branch, with GITHUB_TOKEN above, into its _site/ folder. For local testing, point it at
# an empty folder.
WEB_ROOT=""

# The webhook: the site's workflow signs "a build is ready" with this secret, and the
# host fetches the build at once. Put the same value in the repository's Actions secret
# SLIM_KILLER_WEBHOOK_SECRET. Make one with: php -r "echo bin2hex(random_bytes(32));"
# Empty turns the webhook off; cron still fetches every few minutes.
WEBHOOK_SECRET=""

# A test copy of a website (a staging address): "true" asks search engines not to list
# it. Run `php hammer web:install` again after changing it. Leave empty on the real site.
HIDE_FROM_SEARCH=""
